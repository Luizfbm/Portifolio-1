{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portifolio",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "portfolio.luizfbm.win",
      "custom_domain": true
    }
  ]
}
